[Unit]
Description=MU300 VPN (VLESS via sing-box, TUN + kill switch)
After=mu300-firewall.service mu300-mobile-data.service
Wants=mu300-mobile-data.service
ConditionPathExists=/etc/mu300/vpn.conf
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/mu300/bin/mu300-vpn run
# sing-box exits with "missing default interface" when it starts before the modem has a default route;
# keep retrying instead of hitting the start limit and giving up
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
